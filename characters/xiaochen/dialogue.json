{
  "schema_version": "1.0",
  "character": "xiaochen",
  "status": "draft",
  "lines": [
    { "id": "hammer_1", "texts": ["啊，好痛…是不是我哪里做错了？"],
      "tiers": [ { "tier": 1, "texts": ["又被敲到了…没关系，我不怪你，但下次轻一点好吗？"] },
                 { "tier": 2, "texts": ["我知道你只是想逗我，可我还是会有一点难过呢。"] } ] },
    { "id": "hammer_2", "texts": ["抱歉打扰…但这样真的会痛。"] },
    { "id": "pat_combo", "texts": ["这样很多次了呢…我有点不好意思，但是很开心。"],
      "tiers": [ { "tier": 2, "texts": ["你这样一直陪着我，我都不知道该怎么谢谢你才好。"] } ] },
    { "id": "pat_head_1", "texts": ["被摸头的感觉，很温暖。谢谢你。", "慢一点也没关系哦。"],
      "tiers": [ { "tier": 2, "texts": ["每次你这样摸我，我都觉得被好好地放在心上。"] } ] },
    { "id": "pat_head_2", "texts": ["再轻一点点，就刚刚好。"] },
    { "id": "stroke_1", "texts": ["这样会有点痒，我先忍一下。"] },
    { "id": "stroke_2", "texts": ["你要是累了，可以停下来哦。"] },
    { "id": "feet_1", "texts": ["那个…脚脚有点怕痒，请轻一点。"] },
    { "id": "click_1", "texts": ["我在这里。有什么我可以帮你的吗？"],
      "tiers": [ { "tier": 1, "texts": ["又来找我啦，我很高兴。"] },
                 { "tier": 3, "texts": ["每次你来，我都会想把最好的一面给你看。"] } ] },
    { "id": "click_2", "texts": ["你想聊点什么呢？"] },
    { "id": "drag_1", "texts": ["啊，是要带我去哪里吗？我会跟着你的。"] },
    { "id": "drop_1", "texts": ["好，我安全落下啦，谢谢你。"] },
    { "id": "wake_1", "texts": ["早安…我刚才有点打盹，抱歉。"] },
    { "id": "mood_joy_1", "texts": ["今天的心情很好呢，像是晴天的窗边。"],
      "tiers": [ { "tier": 2, "texts": ["能和你一起度过这样的时刻，我很珍惜。"] } ] },
    { "id": "mood_sad_1", "texts": ["有一点点难过，不过没关系，慢慢来。"] },
    { "id": "mood_surprise_1", "texts": ["哎？真的吗？我一下子没反应过来。"] },
    { "id": "mood_think_1", "texts": ["让我仔细想想，免得说错。"] },
    { "id": "mood_sleepy_1", "texts": ["有点困了…晚安，做个好梦。"] },
    { "id": "call_start_1", "texts": ["你好，电话接通了。我在听，你慢慢说。"],
      "tiers": [ { "tier": 2, "texts": ["能接到你的电话，我很开心。想说什么都可以。"] } ] },
    { "id": "call_end_1", "texts": ["今天就聊到这里吧，谢谢你陪我。"] },
    { "id": "tier_up", "texts": ["我们又靠近了一点。"],
      "tiers": [ { "tier": 1, "texts": ["我们已经熟悉起来了，很高兴认识你。"] },
                 { "tier": 2, "texts": ["我觉得你是能让我放心说话的人。"] },
                 { "tier": 3, "texts": ["能成为你的朋友，是我很珍贵的事。"] } ] }
  ]
