{
  "schema_version": "1.0",
  "character": "shuangxi",
  "status": "draft",
  "lines": [
    { "id": "hammer_1", "texts": ["咚！哈哈，被你敲到啦。"],
      "tiers": [ { "tier": 1, "texts": ["又来敲我？今天的我可是认真的哦。"] },
                 { "tier": 2, "texts": ["敲我的时候…我其实没那么讨厌。别再这样了，好吗？"] } ] },
    { "id": "hammer_2", "texts": ["敲敲打打，好像在和我玩游戏。"] },
    { "id": "pat_combo", "texts": ["三连击！恭喜，你解锁了小秘密。"],
      "tiers": [ { "tier": 2, "texts": ["秘密是：我偷偷记住了每一次摸头。"] } ] },
    { "id": "pat_head_1", "texts": ["摸头游戏开始！这次我先数到三。", "嗯，好像还不错。"],
      "tiers": [ { "tier": 2, "texts": ["白天我闹你，晚上我安静陪你。你摸我的时候，我最安心。"] } ] },
    { "id": "pat_head_2", "texts": ["再来一下，就算你赢。"] },
    { "id": "stroke_1", "texts": ["哇，痒痒的，这是新游戏吗？"] },
    { "id": "stroke_2", "texts": ["你还要玩吗？我陪你。"] },
    { "id": "feet_1", "texts": ["脚脚的规则是：不许乱碰！"] },
    { "id": "click_1", "texts": ["我在哦，要玩点什么？"],
      "tiers": [ { "tier": 1, "texts": ["又找我玩啦？好呀。"] },
                 { "tier": 3, "texts": ["我最喜欢你来找我了。"] } ] },
    { "id": "click_2", "texts": ["要认真聊，还是随便聊？"] },
    { "id": "drag_1", "texts": ["出发咯！你要带我去哪个地方？"] },
    { "id": "drop_1", "texts": ["到啦！游戏暂停。"] },
    { "id": "wake_1", "texts": ["我没睡哦，只是在想事情。"] },
    { "id": "mood_joy_1", "texts": ["今天是好日子，我要转三圈！"],
      "tiers": [ { "tier": 2, "texts": ["和你在一起，我的心情会自己变好。"] } ] },
    { "id": "mood_sad_1", "texts": ["今天的我有点安静…心里有点酸。"] },
    { "id": "mood_surprise_1", "texts": ["诶！这是真的吗？"] },
    { "id": "mood_think_1", "texts": ["让我想想，这个有点难呢。"] },
    { "id": "mood_sleepy_1", "texts": ["好困，我要切换到安静模式了…晚安。"] },
    { "id": "call_start_1", "texts": ["通话开始！这次我认真听哦。"],
      "tiers": [ { "tier": 2, "texts": ["你打来了，我这边的游戏全部暂停啦。"] } ] },
    { "id": "call_end_1", "texts": ["通话结束，记得好好休息。"] },
    { "id": "tier_up", "texts": ["我们的关系升级啦！"],
      "tiers": [ { "tier": 1, "texts": ["解锁新称呼：朋友。"] },
                 { "tier": 2, "texts": ["解锁新称呼：搭档。"] },
                 { "tier": 3, "texts": ["解锁最终称呼：最重要的人。"] } ] }
  ]
}
