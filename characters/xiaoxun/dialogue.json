    { "id": "call_end_1", "texts": ["下次再聊呀。"] },
    { "id": "tier_up", "texts": ["我们更熟了一点呢。"],
      "tiers": [ { "tier": 1, "texts": ["我们熟起来啦，以后多找我玩吧！"] },
