    { "id": "click_2", "texts": ["找我有事吗？"] },
    { "id": "drag_1", "texts": ["啊啊啊，带我去哪里呀？"] },
    { "id": "drop_1", "texts": ["呼…落地成功！"] },
    { "id": "wake_1", "texts": ["唔…我没有睡着哦。"] },
    { "id": "mood_joy_1", "texts": ["今天好开心呀！"],
