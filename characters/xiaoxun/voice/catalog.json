      "file": "characters/xiaoxun/voice/lines/hammer_1_base1.mp3",
      "bytes": 27360
    },
    {
      "id": "hammer_1",
      "variant": "tier1_0",
      "tier": 1,
      "text": "又敲我？我记住你了哦！",
      "voice": "zh-CN-XiaoyiNeural",
