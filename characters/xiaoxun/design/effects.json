      },
      "param": {
        "prefix": "ParamSparkle",
        "label": "闪光{i} 生命周期",
        "min_scale": 0.45,
        "default_from_phase": [
          0.25,
          0.5
        ],
        "note": "参数 0 = 缩到 min_scale 且全透明，1 = 原尺寸全亮。默认值按相位错开，否则别的动作接管时八颗会一样大"
      },
      "gates": [
        {
          "param": "ParamStarEye",
          "scale": 1.0,
          "offset": -1.0,
          "note": "星星眼总闸。alpha 在引擎里是相乘累加，所以最终透明度 = 开门 × 这一颗的生命周期"
        },
        {
          "param": "ParamMouthForm",
          "scale": 2.0,
          "offset": -1.0,
          "note": "笑门（T39.5）。商业成品的触发口径是「笑顔で目を見開いたときに」（BOOTH 5711516），不是开了星星眼就一直闪。嘴角 0 不出、0.25 出一半、>=0.5 满亮"
        }
      ],
      "motion": {
        "action": "idle",
        "wave": "sine",
        "amp": 0.62,
        "bias": 0.38,
        "note": "取值范围 [-0.24, 1.0]，负的那段被 alpha 的 clamp 压成全透明 —— 每颗约四分之一周期完全不在，才像『闪一下又没了』，不是八个灯一起呼吸。不用 pulse 是因为 pulse 一次性，idle 要循环"
      },
