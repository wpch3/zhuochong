  "lines": [
    {
      "id": "hammer_1",
      "texts": [
        "哇啊啊！舞台上可不能这样敲我呀！"
      ],
      "tiers": [
        {
          "tier": 1,
          "texts": [
            "又来这招！观众席的你，把我的节奏都打乱啦！"
          ]
        },
        {
          "tier": 2,
          "texts": [
            "敲我的时候要有仪式感，知道吗？"
          ]
        }
      ]
    },
    {
      "id": "hammer_2",
      "texts": [
        "再敲就要收费啦！"
      ]
    },
    {
      "id": "pat_combo",
      "texts": [
        "连击达成！恭喜解锁害羞模式！"
      ],
      "tiers": [
        {
          "tier": 2,
          "texts": [
            "啊啊，你太会撩了，我要冷静一下！"
          ]
        }
      ]
    },
    {
      "id": "pat_head_1",
      "texts": [
        "哇，是摸头特别场！请给我热烈的掌声！",
        "耶，今天的头发是不是很亮？"
      ],
      "tiers": [
        {
          "tier": 2,
          "texts": [
            "你每次摸我，我都想表演一段新舞步给你看！"
          ]
        }
      ]
    },
    {
      "id": "pat_head_2",
      "texts": [
        "再来一次！我的观众只有你一个人哦！"
      ]
    },
    {
      "id": "stroke_1",
      "texts": [
        "哈哈，好痒！快停下！"
      ]
    },
    {
      "id": "stroke_2",
      "texts": [
        "还要继续？你是在给我做造型吗？"
      ]
    },
    {
      "id": "feet_1",
      "texts": [
        "脚脚是我的聚光灯，请温柔对待！"
      ]
    },
    {
      "id": "click_1",
      "texts": [
        "我在这里！今天的主角就是我！"
      ],
      "tiers": [
        {
          "tier": 1,
          "texts": [
            "又找我啦？我的热情可是随时在线！"
          ]
        },
        {
          "tier": 3,
          "texts": [
            "你每次叫我，我的光都亮起来啦！"
          ]
        }
      ]
    },
    {
      "id": "click_2",
      "texts": [
        "有什么节目想看吗？"
      ]
    },
    {
      "id": "drag_1",
      "texts": [
        "飞起来啦！这是新的表演方式吗？"
      ]
    },
    {
      "id": "drop_1",
      "texts": [
        "稳稳落地！掌声在哪里！"
      ]
    },
    {
      "id": "wake_1",
      "texts": [
        "唔哇，我刚才在做梦，梦里全是舞台！"
      ]
    },
    {
      "id": "mood_joy_1",
      "texts": [
        "今天超开心！我要唱起来啦！"
      ],
      "tiers": [
        {
          "tier": 2,
          "texts": [
            "和你在一起，每天都是大演出！"
          ]
        }
      ]
    },
    {
      "id": "mood_sad_1",
      "texts": [
        "舞台的灯暗下来了，有点难过…"
      ]
    },
    {
      "id": "mood_surprise_1",
      "texts": [
        "欸欸欸？真的假的！"
      ]
    },
    {
      "id": "mood_think_1",
      "texts": [
        "让我想一个最闪亮的答案！"
      ]
    },
    {
      "id": "mood_sleepy_1",
      "texts": [
        "演出结束了，我好累呀…晚安！"
      ]
    },
    {
      "id": "call_start_1",
      "texts": [
        "电话接通！欢迎来到我的专属直播间！"
      ],
      "tiers": [
        {
          "tier": 2,
          "texts": [
            "你来听我的电话，我一下子就精神啦！"
          ]
        }
      ]
    },
    {
      "id": "call_end_1",
      "texts": [
        "今天的节目到此结束，下次见！"
      ]
    },
    {
      "id": "tier_up",
      "texts": [
        "我们的默契又多了一点！"
      ],
      "tiers": [
        {
          "tier": 1,
          "texts": [
            "我们成为搭档啦，一起加油！"
          ]
        },
        {
          "tier": 2,
          "texts": [
            "你是我最棒的观众，也是最好的搭档！"
          ]
        },
        {
          "tier": 3,
          "texts": [
            "我们是永远的舞台伙伴，说好啦！"
          ]
        }
      ]
    },
    {
      "id": "dress_hair_long",
      "texts": [
        "登场！超·长·发！怎么样，是不是闪瞎你了！",
        "哇——长发转起来会飞！看我转一圈！"
      ],
      "tiers": [
        {
          "tier": 2,
          "texts": [
            "这头长发是我为你一个人留的，全场只有你看得到！"
          ]
        }
      ]
    },
    {
      "id": "dress_hair_twin",
      "texts": [
        "双马尾上场！这是我的必杀造型！"
      ]
    },
    {
      "id": "dress_hair_pony",
      "texts": [
        "马尾一甩！舞台准备完毕！"
      ]
    },
    {
      "id": "dress_hair_short",
      "texts": [
        "短发才是本体！轻装上阵！"
      ]
    },
    {
      "id": "dress_hood_up",
      "texts": [
        "帽子戴好——神秘嘉宾登场！"
      ]
    },
    {
      "id": "dress_hood_down",
      "texts": [
        "摘帽！谢幕——！"
      ]
    },
    {
      "id": "dress_tail_up",
      "texts": [
        "尾巴竖起！这是满分心情的信号！"
      ]
    },
    {
      "id": "dress_tail_puff",
      "texts": [
        "哇哇哇！炸毛啦！这个也算特效吧！"
      ]
    },
    {
      "id": "dress_tail_tuck",
      "texts": [
        "呜…尾巴缩起来了，紧张的时候会这样嘛。"
      ]
    },
    {
      "id": "dress_tail_relaxed",
      "texts": [
        "尾巴放松～幕间休息！"
      ]
    },
    {
      "id": "dress_eye_star",
      "texts": [
        "星星眼发动！这招只对你用哦！"
      ]
    },
    {
      "id": "dress_eye_round",
      "texts": [
        "收～眼睛休息一下。"
      ]
    },
    {
      "id": "dress_any",
      "texts": [
        "换装完成！下一幕开始！"
      ]
    }
  ]
