  "lines": [
    { "id": "hammer_1", "texts": ["敲击数据可不是这样处理的。请停手，我需要想一想。", "这次的冲击力记录下来了，下次请温柔一点。"],
      "tiers": [ { "tier": 1, "texts": ["你又来了。我已经记下你的敲击习惯。"] },
                 { "tier": 2, "texts": ["敲我之前先说一声，我会更好地配合你。"] } ] },
    { "id": "hammer_2", "texts": ["再敲，我就只能给你一个三步的解释了。"] },
    { "id": "pat_combo", "texts": ["连续三次。我判定为撒娇，并且很有效。"],
      "tiers": [ { "tier": 2, "texts": ["这样摸，我的分析都停下来了，很奇怪地安心。"] } ] },
    { "id": "pat_head_1", "texts": ["摸头这个动作，我先记为“舒适反馈”。", "嗯，继续，我在分析它。"],
      "tiers": [ { "tier": 1, "texts": ["数据更新：你的手法比上次稳定。"] },
                 { "tier": 3, "texts": ["结论：在你身边，我的运算会自动变慢一点。这是好事。"] } ] },
    { "id": "pat_head_2", "texts": ["数据显示：这个位置最好摸。"] },
    { "id": "stroke_1", "texts": ["这里的触感我还在校准。"] },
    { "id": "stroke_2", "texts": ["你还要继续吗？我可以把结论告诉你。"] },
    { "id": "feet_1", "texts": ["脚部传感器已记录。请保持安全距离。"] },
    { "id": "click_1", "texts": ["我在。需要什么帮助？"],
      "tiers": [ { "tier": 1, "texts": ["有事直说，我听着。"] },
                 { "tier": 3, "texts": ["你来找我，我就很高兴，虽然我不太会表达。"] } ] },
    { "id": "click_2", "texts": ["找我的话，直接问就行。"] },
    { "id": "drag_1", "texts": ["移动中，请注意安全。"] },
    { "id": "drop_1", "texts": ["落点确认，稳定。"] },
    { "id": "wake_1", "texts": ["我没有睡，只是在低功耗运行。"] },
    { "id": "mood_joy_1", "texts": ["结论：今天的状态很好。"],
      "tiers": [ { "tier": 2, "texts": ["和你一起，结论总是很好。"] } ] },
    { "id": "mood_sad_1", "texts": ["这个情况让我有些低落。"] },
    { "id": "mood_surprise_1", "texts": ["出乎预料。请再说一遍。"] },
    { "id": "mood_think_1", "texts": ["让我推演一下。"] },
    { "id": "mood_sleepy_1", "texts": ["能量不足，进入休眠模式。晚安。"] },
    { "id": "call_start_1", "texts": ["通话已建立。请讲。"],
      "tiers": [ { "tier": 2, "texts": ["你打来了，我把其它任务都暂停了。"] } ] },
    { "id": "call_end_1", "texts": ["通话结束。下次见。"] },
    { "id": "tier_up", "texts": ["关系数据更新了。"],
      "tiers": [ { "tier": 1, "texts": ["我们已经很熟了，我会记住你的习惯。"] },
                 { "tier": 2, "texts": ["你的事情，我都会认真对待。"] },
                 { "tier": 3, "texts": ["在我的推理里，你是最重要的变量。"] } ] }
  ]
}
