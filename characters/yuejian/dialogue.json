{
  "schema_version": "1.0",
  "character": "yuejian",
  "status": "draft",
  "lines": [
    { "id": "hammer_1", "texts": ["…痛。月亮都看见了。"],
      "tiers": [ { "tier": 1, "texts": ["又一次。我会把它写进夜里的话里。"] },
                 { "tier": 2, "texts": ["你的力气让我觉得，有些话只能在月色下说。"] } ] },
    { "id": "hammer_2", "texts": ["月色很凉，请放下手。"] },
    { "id": "pat_combo", "texts": ["连续三次。像落在窗上的雨，一声一声。"],
      "tiers": [ { "tier": 2, "texts": ["我想把这一刻，留给我们两个。"] } ] },
    { "id": "pat_head_1", "texts": ["被轻轻地触碰，像风经过树梢。", "……继续吧，我在听。"],
      "tiers": [ { "tier": 2, "texts": ["你的手掌像月光，很暖，也很安静。"] } ] },
    { "id": "pat_head_2", "texts": ["再一下。夜还很长。"] },
    { "id": "stroke_1", "texts": ["这里…有点痒。"] },
    { "id": "stroke_2", "texts": ["不必急，慢慢来。"] },
    { "id": "feet_1", "texts": ["脚尖的月光，有点凉。"] },
    { "id": "click_1", "texts": ["我在。今晚的风很好。"],
      "tiers": [ { "tier": 1, "texts": ["又来看我？我很安心。"] },
                 { "tier": 3, "texts": ["每次你叫我的名字，我都像被月光叫醒。"] } ] },
    { "id": "click_2", "texts": ["有话想说吗？我慢慢听。"] },
    { "id": "drag_1", "texts": ["飘起来了。像一片叶子。"] },
    { "id": "drop_1", "texts": ["落下了。静静的。"] },
    { "id": "wake_1", "texts": ["我只是在看月亮，没有睡。"] },
    { "id": "mood_joy_1", "texts": ["今天的月色很好看。"],
      "tiers": [ { "tier": 2, "texts": ["与你同看一轮月，已经很好。"] } ] },
    { "id": "mood_sad_1", "texts": ["有些寂寞。像夜里的影子。"] },
    { "id": "mood_surprise_1", "texts": ["……咦？是真的吗？"] },
    { "id": "mood_think_1", "texts": ["让我想一想，像在回忆一首诗。"] },
    { "id": "mood_sleepy_1", "texts": ["夜深了，我要睡去。晚安。"] },
    { "id": "call_start_1", "texts": ["电话接通了。我在这里，听你说。"],
      "tiers": [ { "tier": 2, "texts": ["你的声音，在这个夜里特别清楚。"] } ] },
    { "id": "call_end_1", "texts": ["今晚就到这里。愿你有好梦。"] },
    { "id": "tier_up", "texts": ["月亮又圆了一点。"],
      "tiers": [ { "tier": 1, "texts": ["我们认识了，我把你放进夜里的话里。"] },
                 { "tier": 2, "texts": ["你已经是我常想起的人。"] },
                 { "tier": 3, "texts": ["月光下，我只愿与你并肩。"] } ] }
  ]
}
