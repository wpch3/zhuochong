    { "id": "ParamMouthOpen", "label": "张嘴", "min": 0, "max": 1, "default": 0 },
    { "id": "ParamBrow", "label": "眉毛", "min": -1, "max": 1, "default": 0 },
    { "id": "ParamBlush", "label": "脸红", "min": 0, "max": 1, "default": 0.2 },
