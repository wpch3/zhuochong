{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "persona_presets.json - 性格预设库与可调维度",
  "type": "object",
  "required": [
    "schema_version",
    "traits",
    "presets"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "_note": {
      "type": "string"
    },
    "traits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 23
          },
          "name": {
            "type": "string",
            "maxLength": 23
          },
          "low": {
            "type": "string",
            "maxLength": 31
          },
          "high": {
            "type": "string",
            "maxLength": 31
          },
          "default": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 23
          },
          "name": {
            "type": "string",
            "maxLength": 31
          },
          "style": {
            "type": "string",
            "maxLength": 255
          },
          "traits": {
            "type": "object"
          }
        }
      }
    }
  }
}
