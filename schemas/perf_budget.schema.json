{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "perf_budget",
  "type": "object",
  "required": ["schema_version", "priority", "budgets", "measured", "degradable"],
  "properties": {
    "schema_version": {"type": "string"},
    "priority": {"type": "object", "required": ["render_first"], "properties": {"render_first": {"type": "boolean"}}},
    "budgets": {"type": "array"},
    "measured": {"type": "object", "required": ["idle_cpu", "realtime_cpu", "render_ms"], "properties": {"idle_cpu": {"type": "number"}, "realtime_cpu": {"type": "number"}, "render_ms": {"type": "number"}}},
    "degradable": {"type": "array"},
    "yield_on_user_active": {"type": "object"}
  }
}
