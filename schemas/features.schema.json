{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "features.json - 功能模块开关与 token 上限",
  "type": "object",
  "required": ["schema_version", "modules"],
  "properties": {
    "schema_version": { "type": "string" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "enabled"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9_]+" },
          "name": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "token_limit": { "type": "number", "minimum": 0 },
          "daily_token_limit": { "type": "number", "minimum": 0 },
          "note": { "type": "string" }
        }
      }
    }
  }
}
