{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dialogue.json - 角色台词（按好感档位给变体）",
  "type": "object",
  "required": ["schema_version", "character", "lines"],
  "properties": {
    "schema_version": { "type": "string" },
    "character": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "approved"] },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "texts"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 47 },
          "texts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "tiers": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["tier", "texts"],
              "properties": {
                "tier": { "type": "integer", "minimum": 0, "maximum": 3 },
                "texts": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": { "type": "string", "minLength": 1, "maxLength": 200 }
                }
              }
            }
          }
        }
      }
    }
  }
}
