# 构建产物
build/
# 打包目录会把 characters/ 里的贴图再拷一份（12MB），不入库。
# exe 本身在 dist/windows/x86_64/ 下，那个是跟踪的（和 zhuochong.exe 同惯例）。
dist/windows/帧率测试/
*.o
*.obj
*.pdb

# 运行期数据（只存本机，不入库）
logs/
# ★ 只忽略仓库根的 data/（预览进程写的 usage.jsonl 之类）。
#   原来写成 data/ 会**连 tests/data/ 一起吞掉** —— 2026-10-17 做 T47.1 时，
#   600 步金标准就这么被悄悄忽略了：本地全绿、CI 一 checkout 就红（文件根本没提交）。
/data/
config/settings.json

# 工具缓存
__pycache__/
*.pyc
.venv/

# 临时
*.tmp
/tmp/

# 密钥与本机环境（绝不入库）
.env
*.env.local

# 语音模型（大文件，不入库；voice_packs.py 安装后在本地，用 voice_setup.sh 可重新下载）
voices/*/model.onnx
voices/*/model.onnx.json
.cache/

# 网络检索来的参考图（许可不明，只作查证用，不入库）
image-search/
