# 构建产物
build/
*.o
*.obj
*.pdb

# 运行期数据（只存本机，不入库）
logs/
data/
config/settings.json

# 工具缓存
__pycache__/
*.pyc
.venv/

# 临时
*.tmp
/tmp/

# 密钥与本机环境（绝不入库）
.env
*.env.local

# 语音模型（大文件，不入库；voice_packs.py 安装后在本地，用 voice_setup.sh 可重新下载）
voices/*/model.onnx
voices/*/model.onnx.json
.cache/

# 网络检索来的参考图（许可不明，只作查证用，不入库）
image-search/
